# secrets
.env
# third-party tools are cloned here at pinned commits (see README)
tools/*
!tools/.keep
# raw EvidenceForge output: only the 8 v3 test incidents (S21-S28) are shipped; regenerate the rest with 03_scenarios/generate.sh
03_scenarios/generated/*
!03_scenarios/generated/.keep
!03_scenarios/generated/S2[1-8]/
03_scenarios/generated/*.log
# EvidenceForge's resolved config dump: unused by the code, and it embeds the generator's fake example keys
# (AWS/Stripe documentation examples), which GitHub secret scanning can flag
03_scenarios/generated/*/C1/RESOLVED_SCENARIO.yaml
# model weights are not shipped
*.safetensors
*.tar.gz
*.tar.zst
# python / notebooks
__pycache__/
.venv/
*.pyc
.ipynb_checkpoints/
# blank hand-scoring sheets that score.py writes next to the filled one
08_analysis/*.new.csv
08_analysis/*.new.json
