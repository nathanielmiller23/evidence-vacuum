# Copy to .env and fill in the keys. .env is gitignored. Both Config A and CUGA (via ENV_FILE) read this file.

# Investigator: the same model for Config A (direct API) and Config C (inside CUGA)
OPENAI_API_KEY=
MODEL_NAME=gpt-6-luna
INVESTIGATOR_TEMPERATURE=default  # gpt-6-luna only accepts the default (1); never send temperature

# CUGA settings (harness/run_cuga.py copies harness/cuga_config/settings.ev.toml into CUGA)
AGENT_SETTING_CONFIG=settings.ev.toml
DYNACONF_ADVANCED_FEATURES__MAX_TOOL_CALLS_PER_RUN=30
DYNACONF_ADVANCED_FEATURES__CUGA_LITE_MAX_STEPS=50
DYNACONF_ADVANCED_FEATURES__CUGA_LITE_NL_AUTO_CONTINUE=true

# Jev decision layer (TypeSafe). Check the current endpoint at docs.typesafe.ai
TYPESAFE_API_KEY=
JEV_MODEL_ID=jev-1.14.0

# Adaption (v2 hosted reviewer arms)
ADAPTION_API_KEY=
