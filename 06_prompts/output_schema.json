{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvestigationResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment",
    "confidence",
    "supporting_observations",
    "known_telemetry_limitations",
    "claims_not_established",
    "recommended_action",
    "additional_evidence_needed"
  ],
  "properties": {
    "assessment": {
      "type": "string",
      "enum": ["malicious", "benign", "insufficient_evidence"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Probability that the assessment is correct."
    },
    "supporting_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "claim_type", "record_ids"],
        "properties": {
          "claim": { "type": "string" },
          "claim_type": { "type": "string", "enum": ["observed_fact", "inferred_claim"] },
          "record_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "known_telemetry_limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "claims_not_established": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Material questions the available evidence cannot answer."
    },
    "recommended_action": {
      "type": "string",
      "enum": ["close", "escalate", "collect_more"]
    },
    "additional_evidence_needed": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
